---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { searchArticles, getCategories, getTrending } from '../lib/api';

const query = Astro.url.searchParams.get('q') || '';

const [articles, categories, trending] = await Promise.all([
  query ? searchArticles(query, 20) : Promise.resolve([]),
  getCategories(),
  getTrending('today', 5),
]);
---

<Layout
  title={query ? `Hasil Pencarian: "${query}" - Tailnews` : 'Pencarian Berita - Tailnews'}
  description="Cari berita terkini, artikel mendalam, dan informasi terpercaya di portal berita Tailnews."
  categories={categories}
>
  <div class="bg-gray-50 py-8">
    <div class="xl:container mx-auto px-3 sm:px-4 xl:px-2">
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-xs text-gray-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-black">Home</a>
        <span>/</span>
        <span class="text-gray-800 font-semibold">Pencarian</span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Main Search Content -->
        <div class="w-full lg:w-2/3">
          <div class="bg-white p-6 sm:p-8 rounded-sm border border-gray-100 shadow-sm mb-6">
            <!-- Search Form -->
            <form action="/search" method="GET" class="mb-6">
              <label for="search-input" class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">
                Cari Berita & Artikel
              </label>
              <div class="flex items-stretch">
                <input
                  id="search-input"
                  type="text"
                  name="q"
                  value={query}
                  placeholder="Ketik topik atau kata kunci berita..."
                  class="w-full py-3 px-4 text-sm text-gray-800 bg-gray-50 border border-gray-300 rounded-l focus:outline-none focus:ring-1 focus:ring-black"
                  required
                />
                <button
                  type="submit"
                  class="bg-black hover:bg-red-600 text-white px-6 py-3 text-xs font-bold uppercase tracking-wider rounded-r transition-colors flex items-center space-x-2"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                  <span>Cari</span>
                </button>
              </div>
            </form>

            <!-- Search Results Header -->
            {query && (
              <div class="border-b-2 border-red-600 pb-3 mb-6 flex justify-between items-end">
                <div>
                  <span class="text-xs text-gray-400 block mb-1">Hasil Pencarian Untuk:</span>
                  <h1 class="text-xl font-bold text-gray-900">
                    &ldquo;<span class="text-red-600">{query}</span>&rdquo;
                  </h1>
                </div>
                <span class="text-xs text-gray-400 font-medium">
                  Ditemukan {articles.length} artikel
                </span>
              </div>
            )}

            <!-- Results List -->
            {query && articles.length === 0 ? (
              <div class="py-12 text-center text-gray-500">
                <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <p class="text-base font-semibold text-gray-700">Tidak ada berita yang cocok</p>
                <p class="text-xs text-gray-400 mt-1">Coba gunakan kata kunci lain atau periksa kembali ejaan Anda.</p>
              </div>
            ) : (
              <div class="divide-y divide-gray-100">
                {articles.map((art) => (
                  <ArticleCard article={art} layout="horizontal" />
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- Sidebar -->
        <div class="w-full lg:w-1/3">
          <Sidebar trending={trending} categories={categories} />
        </div>
      </div>
    </div>
  </div>
</Layout>
