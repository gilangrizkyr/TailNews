---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getAuthor, getCategories, getTrending } from '../../lib/api';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

const cursor = Astro.url.searchParams.get('cursor') || undefined;

const [authorData, categories, trending] = await Promise.all([
  getAuthor(slug, cursor, 12),
  getCategories(),
  getTrending('today', 5),
]);

if (!authorData) {
  return Astro.redirect('/404');
}

const author = authorData.author;
const articles = authorData.articles || [];
const nextCursor = authorData.next_cursor;
const hasMore = authorData.has_more;
---

<Layout
  title={`Profil Jurnalis: ${author.name} - Tailnews`}
  description={`Profil jurnalis ${author.name} beserta seluruh kumpulan liputan investigasi dan berita yang diterbitkan di Tailnews.`}
  categories={categories}
>
  <div class="bg-gray-50 py-8">
    <div class="xl:container mx-auto px-3 sm:px-4 xl:px-2">
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-xs text-gray-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-black">Home</a>
        <span>/</span>
        <span class="text-gray-400">Penulis</span>
        <span>/</span>
        <span class="text-gray-800 font-semibold">{author.name}</span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Main Feed & Author Profile -->
        <div class="w-full lg:w-2/3">
          <!-- Author Bio Header Box -->
          <div class="bg-white p-6 sm:p-8 rounded-sm border border-gray-100 shadow-sm mb-6 flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-6">
            <div class="w-24 h-24 rounded-full bg-gray-200 border-2 border-red-600 flex-shrink-0 flex items-center justify-center text-3xl font-bold text-gray-700 shadow-md">
              {author.name.charAt(0)}
            </div>
            <div class="flex-1">
              <span class="text-xs font-bold text-red-600 uppercase tracking-widest block mb-1">Jurnalis Redaksi</span>
              <h1 class="text-2xl font-black text-gray-900 mb-2">{author.name}</h1>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mb-4">
                {author.bio || 'Jurnalis dan analis berita profesional berdedikasi menyajikan berita faktual dan berimbang.'}
              </p>
              {author.social_links && Object.keys(author.social_links).length > 0 && (
                <div class="flex items-center justify-center sm:justify-start space-x-3 text-xs text-gray-500">
                  <span class="font-semibold text-gray-400">Tautan:</span>
                  {Object.entries(author.social_links).map(([platform, link]) => (
                    <a
                      href={link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-red-600 capitalize underline"
                    >
                      {platform}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>

          <!-- Articles Section -->
          <div class="bg-white p-6 rounded-sm border border-gray-100 shadow-sm">
            <div class="border-b-2 border-red-600 pb-3 mb-6 flex justify-between items-center">
              <h2 class="text-lg font-black uppercase tracking-wider text-gray-900">
                Arsip Liputan oleh {author.name}
              </h2>
              <span class="text-xs text-gray-400">{articles.length} artikel</span>
            </div>

            <!-- Articles List -->
            {articles.length === 0 ? (
              <div class="py-12 text-center text-gray-500">
                <p>Belum ada artikel yang dipublikasikan oleh penulis ini.</p>
              </div>
            ) : (
              <div class="divide-y divide-gray-100">
                {articles.map((art) => (
                  <ArticleCard article={art} layout="horizontal" />
                ))}
              </div>
            )}

            <!-- Keyset Cursor Pagination -->
            <div class="mt-8 pt-4 border-t border-gray-100 flex justify-between items-center">
              {cursor ? (
                <a
                  href={`/author/${slug}`}
                  class="py-2 px-4 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold uppercase tracking-wider rounded-sm transition-colors"
                >
                  &larr; Halaman Pertama
                </a>
              ) : <div />}

              {hasMore && nextCursor && (
                <a
                  href={`/author/${slug}?cursor=${nextCursor}`}
                  class="py-2 px-5 bg-black hover:bg-red-600 text-white text-xs font-bold uppercase tracking-wider rounded-sm transition-colors shadow-sm ml-auto"
                >
                  Berikutnya &rarr;
                </a>
              )}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="w-full lg:w-1/3">
          <Sidebar trending={trending} categories={categories} />
        </div>
      </div>
    </div>
  </div>
</Layout>
