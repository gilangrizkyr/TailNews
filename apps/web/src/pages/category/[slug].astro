---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getArticlesByCategory, getCategories, getTrending } from '../../lib/api';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

const cursor = Astro.url.searchParams.get('cursor') || undefined;

const [feedData, categories, trending] = await Promise.all([
  getArticlesByCategory(slug, cursor, 12),
  getCategories(),
  getTrending('today', 5),
]);

if (!feedData) {
  return Astro.redirect('/404');
}

const currentCategory = categories.find((c) => c.slug === slug);
const categoryName = currentCategory?.name || slug;
const articles = feedData.articles || [];
const nextCursor = feedData.next_cursor;
const hasMore = feedData.has_more;
---

<Layout
  title={`Berita Seputar ${categoryName} Terkini - Tailnews`}
  description={`Kumpulan berita, analisis, dan informasi aktual seputar ${categoryName} terhangat hari ini.`}
  categories={categories}
  activeCategory={slug}
>
  <div class="bg-gray-50 py-8">
    <div class="xl:container mx-auto px-3 sm:px-4 xl:px-2">
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-xs text-gray-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-black">Home</a>
        <span>/</span>
        <span class="text-gray-400">Kategori</span>
        <span>/</span>
        <span class="text-gray-800 font-semibold">{categoryName}</span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Main Feed -->
        <div class="w-full lg:w-2/3">
          <div class="bg-white p-6 rounded-sm border border-gray-100 shadow-sm">
            <!-- Header Kategori -->
            <div class="border-b-2 border-red-600 pb-3 mb-6 flex justify-between items-end">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-red-600 block mb-1">Kanal Berita</span>
                <h1 class="text-2xl font-black text-gray-950 uppercase tracking-tight">
                  {categoryName}
                </h1>
              </div>
              <span class="text-xs text-gray-400">{articles.length} berita dimuat</span>
            </div>

            <!-- Articles List -->
            {articles.length === 0 ? (
              <div class="py-12 text-center text-gray-500">
                <p>Belum ada berita yang diterbitkan di kanal ini.</p>
              </div>
            ) : (
              <div class="divide-y divide-gray-100">
                {articles.map((art) => (
                  <ArticleCard article={art} layout="horizontal" />
                ))}
              </div>
            )}

            <!-- Keyset Cursor Pagination -->
            <div class="mt-8 pt-4 border-t border-gray-100 flex justify-between items-center">
              {cursor ? (
                <a
                  href={`/category/${slug}`}
                  class="py-2 px-4 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold uppercase tracking-wider rounded-sm transition-colors"
                >
                  &larr; Halaman Pertama
                </a>
              ) : <div />}

              {hasMore && nextCursor && (
                <a
                  href={`/category/${slug}?cursor=${nextCursor}`}
                  class="py-2 px-5 bg-black hover:bg-red-600 text-white text-xs font-bold uppercase tracking-wider rounded-sm transition-colors shadow-sm ml-auto"
                >
                  Berikutnya &rarr;
                </a>
              )}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="w-full lg:w-1/3">
          <Sidebar trending={trending} categories={categories} />
        </div>
      </div>
    </div>
  </div>
</Layout>
