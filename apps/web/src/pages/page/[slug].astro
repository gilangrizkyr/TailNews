---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPage, getCategories, getTrending } from '../../lib/api';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

const [pageData, categories, trending] = await Promise.all([
  getPage(slug),
  getCategories(),
  getTrending('today', 5),
]);

if (!pageData) {
  return Astro.redirect('/404');
}
---

<Layout
  title={`${pageData.title} - Tailnews`}
  description={`Informasi resmi ${pageData.title} portal berita Tailnews.`}
  categories={categories}
>
  <div class="bg-gray-50 py-8">
    <div class="xl:container mx-auto px-3 sm:px-4 xl:px-2">
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-xs text-gray-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-black">Home</a>
        <span>/</span>
        <span class="text-gray-400">Halaman</span>
        <span>/</span>
        <span class="text-gray-800 font-semibold">{pageData.title}</span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Main Content -->
        <article class="w-full lg:w-2/3 bg-white p-6 sm:p-10 rounded-sm border border-gray-100 shadow-sm">
          <div class="border-b-2 border-red-600 pb-4 mb-8">
            <h1 class="text-2xl sm:text-3xl font-black text-gray-950 uppercase tracking-tight">
              {pageData.title}
            </h1>
          </div>

          <div class="prose max-w-none text-gray-700 leading-relaxed space-y-4" set:html={pageData.content} />
        </article>

        <!-- Sidebar -->
        <div class="w-full lg:w-1/3">
          <Sidebar trending={trending} categories={categories} />
        </div>
      </div>
    </div>
  </div>
</Layout>
