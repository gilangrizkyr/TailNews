---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getArticleBySlug, getCategories, getTrending, formatDate, estimateReadingTime } from '../lib/api';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

const previewToken = Astro.url.searchParams.get('token') || undefined;

// Parallel SSR data fetching
const [article, categories, trending] = await Promise.all([
  getArticleBySlug(slug, previewToken),
  getCategories(),
  getTrending('today', 5),
]);

if (!article) {
  return Astro.redirect('/404');
}

const formattedDate = formatDate(article.published_at);
const readingTime = estimateReadingTime(article.body || article.excerpt);
const currentUrl = Astro.url.href;
---

<Layout
  title={`${article.seo_title || article.title} - Tailnews`}
  description={article.seo_description || article.excerpt}
  canonicalUrl={currentUrl}
  ogImage={article.cover_url}
  ogType="article"
  publishedTime={article.published_at || undefined}
  authorName={article.author_name}
  categories={categories}
  activeCategory={article.category_slug}
  preloadImage={article.cover_url}
>
  <div class="bg-gray-50 py-8">
    <div class="xl:container mx-auto px-3 sm:px-4 xl:px-2">
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-xs text-gray-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-black">Home</a>
        <span>/</span>
        {article.category_name && (
          <>
            <a href={`/category/${article.category_slug}`} class="hover:text-black">{article.category_name}</a>
            <span>/</span>
          </>
        )}
        <span class="text-gray-600 line-clamp-1">{article.title}</span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Main Article Content -->
        <article class="w-full lg:w-2/3 bg-white p-6 sm:p-8 rounded-sm border border-gray-100 shadow-sm">
          <!-- Preview Notice if draft -->
          {article.status !== 'published' && (
            <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4 mb-6 text-sm text-yellow-800 rounded">
              <span class="font-bold">Mode Pratinjau Redaksional:</span> Artikel ini masih berstatus <span class="uppercase font-mono font-semibold">{article.status}</span> dan belum terbit ke publik luas.
            </div>
          )}

          <!-- Category Badge -->
          {article.category_name && (
            <div class="mb-3">
              <a
                href={`/category/${article.category_slug}`}
                class="inline-block py-1 px-2.5 bg-red-600 text-white text-[11px] font-bold uppercase tracking-widest rounded-sm hover:bg-red-700 transition-colors"
              >
                {article.category_name}
              </a>
            </div>
          )}

          <!-- Title (H1) -->
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-gray-950 leading-tight mb-4">
            {article.title}
          </h1>

          <!-- Excerpt Lead -->
          {article.excerpt && (
            <p class="text-base sm:text-lg text-gray-600 font-normal leading-relaxed mb-6 border-l-3 border-gray-300 pl-4 italic">
              {article.excerpt}
            </p>
          )}

          <!-- Author Byline & Date -->
          <div class="flex flex-wrap items-center justify-between py-3 mb-6 border-y border-gray-100 text-xs text-gray-500 gap-2">
            <div class="flex items-center space-x-3">
              {article.author_name && (
                <div class="flex items-center space-x-2">
                  <span class="font-semibold text-gray-900">
                    Oleh <a href={`/author/${article.author_slug}`} class="hover:text-red-600 underline">{article.author_name}</a>
                  </span>
                </div>
              )}
              <span>&bull;</span>
              <span>{formattedDate}</span>
              <span>&bull;</span>
              <span>{readingTime} menit baca</span>
            </div>

            <!-- Social Share Quick Buttons -->
            <div class="flex items-center space-x-2">
              <span class="text-gray-400 text-[11px] font-semibold uppercase">Bagikan:</span>
              <a
                href={`https://wa.me/?text=${encodeURIComponent(article.title + ' ' + currentUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="p-1.5 bg-green-50 text-green-600 hover:bg-green-600 hover:text-white rounded transition-colors"
                aria-label="Bagikan via WhatsApp"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.074-2.18-.54-1.895-.785-3.111-2.73-3.205-2.855-.095-.125-.769-1.026-.769-1.956 0-.931.488-1.388.663-1.579.174-.191.381-.239.508-.239.127 0 .254.002.366.007.118.006.277-.045.433.332.162.392.551 1.344.599 1.442.048.098.081.213.016.342-.064.129-.096.208-.191.319-.095.111-.202.248-.288.333-.096.096-.197.201-.085.393.112.192.498.824 1.07 1.334.737.656 1.358.859 1.55.955.192.096.304.081.417-.049.112-.13.48-.56.608-.752.127-.192.255-.16.432-.095.178.064 1.127.531 1.32.628.192.096.32.144.368.224.048.081.048.469-.096.874z"/></svg>
              </a>
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(currentUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="p-1.5 bg-blue-50 text-blue-500 hover:bg-blue-500 hover:text-white rounded transition-colors"
                aria-label="Bagikan via Twitter / X"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            </div>
          </div>

          <!-- Featured Image Cover -->
          <div class="mb-8">
            <div class="overflow-hidden bg-gray-100 rounded-sm">
              <img
                src={article.cover_url || '/img/bg.jpg'}
                alt={article.title}
                width="1200"
                height="675"
                class="w-full h-auto object-cover max-h-[500px]"
                fetchpriority="high"
                loading="eager"
              />
            </div>
            {article.excerpt && (
              <p class="text-[11px] text-gray-400 mt-2 italic text-center">
                Dokumentasi Liputan Berita &bull; Redaksi Tailnews
              </p>
            )}
          </div>

          <!-- Article Body HTML -->
          <div class="prose max-w-none text-gray-800 leading-relaxed space-y-4" set:html={article.body} />

          <!-- Tags -->
          {article.tags && article.tags.length > 0 && (
            <div class="mt-8 pt-6 border-t border-gray-100">
              <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Tag Terkait:</h3>
              <div class="flex flex-wrap gap-2">
                {article.tags.map((t) => (
                  <a
                    href={`/tag/${t.slug}`}
                    class="py-1 px-3 bg-gray-100 hover:bg-red-600 hover:text-white text-gray-700 text-xs font-medium rounded-full transition-colors"
                  >
                    #{t.name}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Author Box -->
          {article.author_name && (
            <div class="mt-10 p-5 bg-gray-50 border border-gray-200 rounded-sm flex items-start space-x-4">
              <div class="w-14 h-14 rounded-full bg-gray-300 flex-shrink-0 flex items-center justify-center font-bold text-gray-700 text-xl overflow-hidden">
                {article.author_name.charAt(0)}
              </div>
              <div class="flex-1">
                <h4 class="text-sm font-bold text-gray-900">
                  <a href={`/author/${article.author_slug}`} class="hover:text-red-600 transition-colors">
                    {article.author_name}
                  </a>
                </h4>
                <p class="text-xs text-gray-500 mt-1">
                  Jurnalis dan kontributor redaksi Tailnews. Menulis liputan mendalam dan investigasi terkini.
                </p>
                <div class="mt-2">
                  <a href={`/author/${article.author_slug}`} class="text-xs font-bold text-red-600 hover:underline">
                    Lihat Semua Berita Karya Penulis &rarr;
                  </a>
                </div>
              </div>
            </div>
          )}
        </article>

        <!-- Sidebar -->
        <div class="w-full lg:w-1/3">
          <Sidebar trending={trending} categories={categories} />
        </div>
      </div>
    </div>
  </div>

  <!-- Real-Time View Tracking Script (Deduplicated on Go API) -->
  <script is:inline define:vars={{ articleId: article.id }}>
    window.addEventListener('DOMContentLoaded', () => {
      // Send view ping after reader settles on page for 1.5s
      setTimeout(() => {
        fetch(`/api/v1/articles/${articleId}/view`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        }).catch(() => {});
      }, 1500);
    });
  </script>
</Layout>
