---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import {
  getArticleBySlug,
  getCategories,
  getTrending,
  getArticlesByCategory,
  formatDate,
  estimateReadingTime,
} from '../lib/api';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

const previewToken = Astro.url.searchParams.get('token') || undefined;

// Parallel SSR data fetching
const [article, categories, trending] = await Promise.all([
  getArticleBySlug(slug, previewToken),
  getCategories(),
  getTrending('today', 5),
]);

if (!article) {
  return Astro.redirect('/404');
}

// Fetch related articles from same category
let relatedArticles: any[] = [];
if (article.category_slug) {
  const catRes = await getArticlesByCategory(article.category_slug, undefined, 4);
  relatedArticles = (catRes?.articles || [])
    .filter((a) => a.id !== article.id)
    .slice(0, 3);
}

// Fallback to trending articles if category has fewer than 3 related articles
if (relatedArticles.length < 3) {
  const remainingCount = 3 - relatedArticles.length;
  const existingIds = new Set([article.id, ...relatedArticles.map((a) => a.id)]);
  const fallback = trending.filter((a) => !existingIds.has(a.id)).slice(0, remainingCount);
  relatedArticles = [...relatedArticles, ...fallback];
}

const formattedDate = formatDate(article.published_at);
const readingTime = estimateReadingTime(article.body || article.excerpt);
const currentUrl = Astro.url.href;
---

<Layout
  title={`${article.seo_title || article.title} - Tailnews`}
  description={article.seo_description || article.excerpt}
  canonicalUrl={currentUrl}
  ogImage={article.cover_url}
  ogType="article"
  publishedTime={article.published_at || undefined}
  authorName={article.author_name}
  categories={categories}
  activeCategory={article.category_slug}
  preloadImage={article.cover_url}
>
  <!-- Fixed Reading Progress Indicator -->
  <div
    id="reading-progress-bar"
    class="fixed top-0 left-0 h-1 bg-red-600 z-[9999] transition-all duration-75 pointer-events-none"
    style="width: 0%"
  ></div>

  <div class="bg-gray-50 py-8">
    <div class="xl:container mx-auto px-3 sm:px-4 xl:px-2">
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-xs text-gray-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-black">Home</a>
        <span>/</span>
        {article.category_name && (
          <>
            <a href={`/category/${article.category_slug}`} class="hover:text-black">{article.category_name}</a>
            <span>/</span>
          </>
        )}
        <span class="text-gray-600 line-clamp-1">{article.title}</span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Main Article Content -->
        <article class="w-full lg:w-2/3 bg-white p-6 sm:p-8 rounded-sm border border-gray-100 shadow-sm">
          <!-- Preview Notice if draft -->
          {article.status !== 'published' && (
            <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4 mb-6 text-sm text-yellow-800 rounded">
              <span class="font-bold">Mode Pratinjau Redaksional:</span> Artikel ini masih berstatus <span class="uppercase font-mono font-semibold">{article.status}</span> dan belum terbit ke publik luas.
            </div>
          )}

          <!-- Category Badge -->
          {article.category_name && (
            <div class="mb-3">
              <a
                href={`/category/${article.category_slug}`}
                class="inline-block py-1 px-2.5 bg-red-600 text-white text-[11px] font-bold uppercase tracking-widest rounded-sm hover:bg-red-700 transition-colors"
              >
                {article.category_name}
              </a>
            </div>
          )}

          <!-- Title (H1) -->
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-gray-950 leading-tight mb-4">
            {article.title}
          </h1>

          <!-- Excerpt Lead -->
          {article.excerpt && (
            <p class="text-base sm:text-lg text-gray-600 font-normal leading-relaxed mb-6 border-l-3 border-gray-300 pl-4 italic">
              {article.excerpt}
            </p>
          )}

          <!-- Author Byline, Reading Time & Social Share Bar -->
          <div class="flex flex-wrap items-center justify-between py-3 mb-4 border-y border-gray-100 text-xs text-gray-500 gap-2">
            <div class="flex items-center space-x-3">
              {article.author_name && (
                <div class="flex items-center space-x-2">
                  <span class="font-semibold text-gray-900">
                    Oleh <a href={`/author/${article.author_slug}`} class="hover:text-red-600 underline">{article.author_name}</a>
                  </span>
                </div>
              )}
              <span>&bull;</span>
              <span>{formattedDate}</span>
              <span>&bull;</span>
              <span>{readingTime} menit baca</span>
            </div>

            <!-- Social Share Quick Buttons -->
            <div class="flex items-center space-x-2">
              <span class="text-gray-400 text-[11px] font-semibold uppercase">Bagikan:</span>
              <a
                href={`https://wa.me/?text=${encodeURIComponent(article.title + ' ' + currentUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="p-1.5 bg-green-50 text-green-600 hover:bg-green-600 hover:text-white rounded transition-colors"
                aria-label="Bagikan via WhatsApp"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.074-2.18-.54-1.895-.785-3.111-2.73-3.205-2.855-.095-.125-.769-1.026-.769-1.956 0-.931.488-1.388.663-1.579.174-.191.381-.239.508-.239.127 0 .254.002.366.007.118.006.277-.045.433.332.162.392.551 1.344.599 1.442.048.098.081.213.016.342-.064.129-.096.208-.191.319-.095.111-.202.248-.288.333-.096.096-.197.201-.085.393.112.192.498.824 1.07 1.334.737.656 1.358.859 1.55.955.192.096.304.081.417-.049.112-.13.48-.56.608-.752.127-.192.255-.16.432-.095.178.064 1.127.531 1.32.628.192.096.32.144.368.224.048.081.048.469-.096.874z"/></svg>
              </a>
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(currentUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="p-1.5 bg-blue-50 text-blue-500 hover:bg-blue-500 hover:text-white rounded transition-colors"
                aria-label="Bagikan via Twitter / X"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            </div>
          </div>

          <!-- Accessibility & Audio Reader Toolbar -->
          <div class="flex flex-wrap items-center justify-between bg-gray-50 border border-gray-200/80 px-4 py-2.5 rounded-sm mb-6 gap-3">
            <!-- Simulated Audio Reader -->
            <div class="flex items-center gap-2.5">
              <button
                id="btn-play-audio"
                type="button"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-black hover:bg-red-600 text-white text-xs font-bold uppercase tracking-wider rounded-sm transition-colors cursor-pointer"
              >
                <svg id="icon-play" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
                <svg id="icon-pause" class="w-3.5 h-3.5 fill-current hidden" viewBox="0 0 24 24">
                  <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                </svg>
                <span id="audio-label">Dengarkan Berita</span>
              </button>
              <div id="audio-wave" class="hidden items-center gap-1">
                <span class="w-1 h-3 bg-red-600 animate-pulse"></span>
                <span class="w-1 h-5 bg-red-600 animate-pulse delay-75"></span>
                <span class="w-1 h-2 bg-red-600 animate-pulse delay-150"></span>
                <span class="w-1 h-4 bg-red-600 animate-pulse delay-100"></span>
                <span class="text-[11px] text-gray-500 font-mono ml-1">01:45</span>
              </div>
            </div>

            <!-- Text Size Controls -->
            <div class="flex items-center gap-1 text-xs text-gray-600">
              <span class="text-gray-400 text-[11px] mr-1">Ukuran Huruf:</span>
              <button
                id="font-sm"
                type="button"
                class="px-2 py-1 bg-white border border-gray-200 hover:border-black rounded-xs font-bold text-[11px] cursor-pointer"
              >
                A-
              </button>
              <button
                id="font-md"
                type="button"
                class="px-2 py-1 bg-black text-white border border-black rounded-xs font-bold text-xs cursor-pointer"
              >
                A
              </button>
              <button
                id="font-lg"
                type="button"
                class="px-2 py-1 bg-white border border-gray-200 hover:border-black rounded-xs font-bold text-sm cursor-pointer"
              >
                A+
              </button>
            </div>
          </div>

          <!-- Featured Image Cover -->
          <div class="mb-8">
            <div class="overflow-hidden bg-gray-100 rounded-sm">
              <img
                src={article.cover_url || '/img/bg.jpg'}
                alt={article.title}
                width="1200"
                height="675"
                class="w-full h-auto object-cover max-h-[500px]"
                fetchpriority="high"
                loading="eager"
              />
            </div>
            {article.excerpt && (
              <p class="text-[11px] text-gray-400 mt-2 italic text-center">
                Dokumentasi Liputan Berita &bull; Redaksi Tailnews
              </p>
            )}
          </div>

          <!-- Article Body HTML -->
          <div
            id="article-content-body"
            class="prose prose-neutral max-w-none text-gray-800 leading-relaxed space-y-4 text-base transition-all duration-200"
            set:html={article.body}
          />

          <!-- Tags -->
          {article.tags && article.tags.length > 0 && (
            <div class="mt-8 pt-6 border-t border-gray-100">
              <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Tag Terkait:</h3>
              <div class="flex flex-wrap gap-2">
                {article.tags.map((t) => (
                  <a
                    href={`/tag/${t.slug}`}
                    class="py-1 px-3 bg-gray-100 hover:bg-red-600 hover:text-white text-gray-700 text-xs font-medium rounded-full transition-colors"
                  >
                    #{t.name}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Author Box -->
          {article.author_name && (
            <div class="mt-8 p-5 bg-gray-50 border border-gray-200 rounded-sm flex items-start space-x-4">
              <div class="w-14 h-14 rounded-full bg-gray-300 flex-shrink-0 flex items-center justify-center font-bold text-gray-700 text-xl overflow-hidden">
                {article.author_name.charAt(0)}
              </div>
              <div class="flex-1">
                <h4 class="text-sm font-bold text-gray-900">
                  <a href={`/author/${article.author_slug}`} class="hover:text-red-600 transition-colors">
                    {article.author_name}
                  </a>
                </h4>
                <p class="text-xs text-gray-500 mt-1">
                  Jurnalis dan kontributor redaksi Tailnews. Menulis liputan mendalam dan investigasi terkini.
                </p>
                <div class="mt-2">
                  <a href={`/author/${article.author_slug}`} class="text-xs font-bold text-red-600 hover:underline">
                    Lihat Semua Berita Karya Penulis &rarr;
                  </a>
                </div>
              </div>
            </div>
          )}

          <!-- Rekomendasi Berita Terkait Lainnya (3-Card Grid) -->
          {relatedArticles.length > 0 && (
            <div class="mt-12 pt-8 border-t-2 border-red-600">
              <div class="flex items-center justify-between mb-6">
                <h3 class="text-lg font-black uppercase tracking-wider text-gray-950 flex items-center gap-2">
                  <span class="w-2.5 h-4 bg-red-600 inline-block"></span>
                  Berita Terkait Lainnya
                </h3>
                <span class="text-xs text-gray-400 font-semibold uppercase tracking-wider">
                  Rekomendasi Redaksi
                </span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                {relatedArticles.map((rel) => (
                  <article class="group flex flex-col bg-white border border-gray-100 rounded-sm overflow-hidden hover:shadow-md transition-shadow">
                    <div class="aspect-video w-full overflow-hidden bg-gray-100">
                      <a href={`/${rel.slug}`} class="block w-full h-full">
                        <img
                          src={rel.cover_url || '/img/bg.jpg'}
                          alt={rel.title}
                          width="300"
                          height="169"
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          loading="lazy"
                        />
                      </a>
                    </div>
                    <div class="p-3 flex-1 flex flex-col justify-between">
                      {rel.category_name && (
                        <span class="text-[10px] font-bold text-red-600 uppercase tracking-wider mb-1 block">
                          {rel.category_name}
                        </span>
                      )}
                      <h4 class="text-xs sm:text-sm font-bold text-gray-900 group-hover:text-red-600 line-clamp-2 leading-snug transition-colors mb-2">
                        <a href={`/${rel.slug}`}>
                          {rel.title}
                        </a>
                      </h4>
                      <span class="text-[10px] text-gray-400 mt-auto">
                        {formatDate(rel.published_at)}
                      </span>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )}
        </article>

        <!-- Sidebar -->
        <div class="w-full lg:w-1/3">
          <Sidebar trending={trending} categories={categories} />
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Scripts: Reading Progress Bar, Font Sizer, Audio Simulation, View Tracking -->
  <script is:inline define:vars={{ articleId: article.id }}>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Reading Progress Bar
      const progressBar = document.getElementById('reading-progress-bar');
      window.addEventListener('scroll', () => {
        const docElem = document.documentElement;
        const totalHeight = docElem.scrollHeight - docElem.clientHeight;
        if (totalHeight > 0 && progressBar) {
          const scrollPercent = (window.scrollY / totalHeight) * 100;
          progressBar.style.width = Math.min(scrollPercent, 100) + '%';
        }
      });

      // 2. Font Sizer
      const content = document.getElementById('article-content-body');
      const btnSm = document.getElementById('font-sm');
      const btnMd = document.getElementById('font-md');
      const btnLg = document.getElementById('font-lg');

      const setFont = (sizeClass, activeBtn) => {
        if (!content) return;
        content.classList.remove('text-sm', 'text-base', 'text-lg', 'text-xl');
        content.classList.add(sizeClass);

        [btnSm, btnMd, btnLg].forEach((b) => {
          if (b) {
            b.classList.remove('bg-black', 'text-white', 'border-black');
            b.classList.add('bg-white', 'text-gray-600', 'border-gray-200');
          }
        });
        if (activeBtn) {
          activeBtn.classList.remove('bg-white', 'text-gray-600', 'border-gray-200');
          activeBtn.classList.add('bg-black', 'text-white', 'border-black');
        }
      };

      if (btnSm) btnSm.addEventListener('click', () => setFont('text-sm', btnSm));
      if (btnMd) btnMd.addEventListener('click', () => setFont('text-base', btnMd));
      if (btnLg) btnLg.addEventListener('click', () => setFont('text-lg', btnLg));

      // 3. Audio Reader Simulation
      const btnAudio = document.getElementById('btn-play-audio');
      const iconPlay = document.getElementById('icon-play');
      const iconPause = document.getElementById('icon-pause');
      const wave = document.getElementById('audio-wave');
      const label = document.getElementById('audio-label');
      let isPlaying = false;

      if (btnAudio) {
        btnAudio.addEventListener('click', () => {
          isPlaying = !isPlaying;
          if (isPlaying) {
            if (iconPlay) iconPlay.classList.add('hidden');
            if (iconPause) iconPause.classList.remove('hidden');
            if (wave) {
              wave.classList.remove('hidden');
              wave.classList.add('flex');
            }
            if (label) label.textContent = 'Jeda Audio';
          } else {
            if (iconPlay) iconPlay.classList.remove('hidden');
            if (iconPause) iconPause.classList.add('hidden');
            if (wave) {
              wave.classList.add('hidden');
              wave.classList.remove('flex');
            }
            if (label) label.textContent = 'Dengarkan Berita';
          }
        });
      }

      // 4. View Tracking ping
      setTimeout(() => {
        fetch(`/api/v1/articles/${articleId}/view`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        }).catch(() => {});
      }, 1500);
    });
  </script>
</Layout>
