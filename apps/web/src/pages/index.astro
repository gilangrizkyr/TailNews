---
export const prerender = false;

const internalApiUrl = process.env.INTERNAL_API_URL || 'http://localhost:8080/api/v1';
let apiStatus = 'offline';

try {
  const res = await fetch(`${internalApiUrl}/ping`, { signal: AbortSignal.timeout(1500) });
  if (res.ok) {
    const data = await res.json();
    if (data?.success) {
      apiStatus = 'connected';
    }
  }
} catch {
  apiStatus = 'unreachable';
}
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Portal Berita Modern</title>
</head>
<body class="bg-gray-50 text-gray-800 font-sans p-8">
  <div class="max-w-4xl mx-auto bg-white p-6 rounded shadow">
    <h1 class="text-3xl font-bold mb-4">Portal Berita Modern (Astro SSR)</h1>
    <p class="text-gray-600 mb-2">Mode: <strong>Full SSR (Dynamic Server-Side Rendering)</strong></p>
    <p class="text-gray-600">Backend API Status: <span class="font-semibold text-green-600">{apiStatus}</span></p>
  </div>
</body>
</html>
