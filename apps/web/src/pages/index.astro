---
import Layout from '../layouts/Layout.astro';
import BreakingTicker from '../components/BreakingTicker.astro';
import HeroGrid from '../components/HeroGrid.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getHomepage } from '../lib/api';

// SSR Fetching
const homepageData = await getHomepage();

const headlines = homepageData?.headlines || [];
const breaking = homepageData?.breaking || [];
const latest = homepageData?.latest || [];
const trending = homepageData?.trending || [];
const categories = homepageData?.categories || [];
const nextCursor = homepageData?.next_cursor;

const leadArticle = headlines[0];
const preloadImage = leadArticle?.cover_url;
---

<Layout
  title="Tailnews - Portal Berita Modern, Cepat & Terpercaya"
  description="Portal berita terkini, aktual, dan terpercaya menyajikan informasi politik, ekonomi, teknologi, olahraga, dan gaya hidup di Indonesia dan mancanegara."
  categories={categories}
  preloadImage={preloadImage}
>
  <!-- Breaking News Ticker -->
  <BreakingTicker breaking={breaking} />

  <!-- Hero 5-Grid -->
  <HeroGrid headlines={headlines} />

  <!-- Main Content Feed & Sidebar -->
  <div class="bg-gray-50 py-8">
    <div class="xl:container mx-auto px-3 sm:px-4 xl:px-2">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Feed Utama -->
        <div class="w-full lg:w-2/3">
          <div class="bg-white p-6 rounded-sm border border-gray-100 shadow-sm">
            <!-- Section Title -->
            <div class="border-b-2 border-red-600 pb-3 mb-6 flex justify-between items-center">
              <h2 class="text-lg font-black uppercase tracking-wider text-gray-900 flex items-center">
                <span class="inline-block w-2.5 h-4 bg-red-600 mr-2"></span>
                Berita Terkini
              </h2>
              <span class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Update Realtime</span>
            </div>

            <!-- Articles List -->
            <div class="divide-y divide-gray-100">
              {latest.map((art) => (
                <ArticleCard article={art} layout="horizontal" />
              ))}
            </div>

            <!-- Keyset Cursor Pagination Trigger -->
            {nextCursor && (
              <div class="pt-6 text-center">
                <a
                  href={`/search?cursor=${nextCursor}`}
                  class="inline-block py-2.5 px-6 bg-black hover:bg-red-600 text-white text-xs font-bold uppercase tracking-wider rounded-sm transition-colors shadow-sm"
                >
                  Muat Lebih Banyak Berita &rarr;
                </a>
              </div>
            )}
          </div>
        </div>

        <!-- Sidebar -->
        <div class="w-full lg:w-1/3">
          <Sidebar trending={trending} categories={categories} />
        </div>
      </div>
    </div>
  </div>
</Layout>
