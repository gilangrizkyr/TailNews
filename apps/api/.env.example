# Server Config
PORT=8080
ENV=development
LOG_LEVEL=debug

# Database (MySQL 8 / MariaDB 11)
DB_DSN=root:password@tcp(127.0.0.1:3306)/news_portal?parseTime=true&loc=UTC
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME_MIN=15

# Redis 7
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & JWT (Must be 32+ characters)
JWT_SECRET=replace-with-minimum-32-character-secret-key-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Media Storage
MEDIA_STORAGE_DIR=./data/media
MAX_UPLOAD_SIZE_MB=10

# Cloudflare CDN (Optional for local dev)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4321,http://localhost:5173,http://127.0.0.1:4321
